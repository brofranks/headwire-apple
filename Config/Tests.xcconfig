// Logic tests only: no host app, signed to run locally.
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =
PRODUCT_BUNDLE_IDENTIFIER = $(BUNDLE_ID_PREFIX).tests
// The tests drive the Go bridge itself: the C ABI's contract is theirs to
// check.
OTHER_LDFLAGS = $(inherited) $(GO_BRIDGE_LDFLAGS) -framework IOKit
