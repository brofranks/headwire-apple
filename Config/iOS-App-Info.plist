<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Everything else is generated. Info.plist generation covers none of
	     these: an arbitrary key is not an INFOPLIST_KEY_ setting, and
	     UILaunchScreen_Generation nests the dictionary inside itself. -->
	<key>CFBundleIconName</key>
	<string>Headwire</string>
	<key>HeadwireAppGroup</key>
	<string>$(APP_GROUP)</string>
	<key>UILaunchScreen</key>
	<dict/>
</dict>
</plist>
