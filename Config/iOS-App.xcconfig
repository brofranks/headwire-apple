#include "iOS.xcconfig"

// The iOS app links no Go. The engine is linked only into the app extension.
PRODUCT_BUNDLE_IDENTIFIER = $(BUNDLE_ID_PREFIX)
PRODUCT_NAME = Headwire
PROVISIONING_PROFILE_SPECIFIER = $(PROFILE_APP)
ASSETCATALOG_COMPILER_APPICON_NAME = Headwire
INFOPLIST_FILE = Config/iOS-App-Info.plist
INFOPLIST_KEY_UISupportedInterfaceOrientations = UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight
INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents = YES
INFOPLIST_KEY_ITSAppUsesNonExemptEncryption = NO
